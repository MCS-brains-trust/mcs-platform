{
  "name": "statementhub-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Playwright regression suite for StatementHub",
  "scripts": {
    "test": "playwright test",
    "test:tier1": "playwright test --project=tier1",
    "test:tier2": "playwright test --project=tier2",
    "report": "playwright show-report",
    "refresh-db": "bash ../scripts/refresh_e2e_db.sh",
    "bootstrap": "bash ./scripts/bootstrap.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "otplib": "^12.0.1"
  }
}
